# Server-only. Copy to .env.local and fill locally; never commit credentials.
TYPESAFE_API_KEY=
DATABASE_URL=
# Set to true to show a "Jev limit reached" page and disable the whole app.
JEV_LIMIT_REACHED=false

# Email (optional). Without SMTP_URL and MAIL_FROM the backoffice buttons fall back to mailto: links.
# Any SMTP provider works, e.g. smtps://USER:PASSWORD@smtp.provider.com:465 or smtp://USER:PASSWORD@host:587.
# Locally, a Mailpit container catches everything: smtp://127.0.0.1:1025 (web UI on http://localhost:8025).
SMTP_URL=
MAIL_FROM=
# Optional: reply-to address for mail sent to customers.
MAIL_REPLY_TO=
# Optional: where to be told about each new request (sent once per request).
MAIL_NOTIFY_TO=
# Public address of the app, used for links inside notification emails.
APP_URL=http://localhost:3000